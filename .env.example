# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=id_verificator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Face verification ─────────────────────────────────────────────────────────
# Model options: VGG-Face (fast), Facenet512 (accurate), ArcFace (best accuracy)
# Threshold: max face distance accepted as a match — lower = stricter
FACE_MODEL=ArcFace
FACE_THRESHOLD=0.50
